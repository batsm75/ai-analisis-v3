# ============================================================
#  KONFIGURASI API KEY — isi sendiri, file ini TIDAK di-commit
#  Salin file ini menjadi ".env" lalu isi nilai di bawah.
#  Atau atur lewat menu [3] Env di dalam aplikasi.
# ============================================================

# --- GROQ (otak AI / analisis utama) ---
# Dapatkan key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- TwelveData (data market: forex, saham, crypto, indeks) ---
# Dapatkan key: https://twelvedata.com/account/api-keys
TWELVEDATA_API_KEY=
TWELVEDATA_BASE_URL=https://api.twelvedata.com

# --- SoSoValue (data market v3: US equity & perpetual futures) ---
# Dapatkan key: https://sosovalue.com/developer
# Catatan: v3 saat ini mencakup US equities & perpetual futures
# (belum ada spot forex). Untuk pair forex, analisis tetap berjalan
# menggunakan TwelveData.
SOSOVALUE_API_KEY=
SOSOVALUE_BASE_URL=https://openapi.sosovalue.com/openapi/v3
